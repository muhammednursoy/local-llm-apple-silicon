{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://127.0.0.1:11434/v1" },
      "models": {
        "gemma4-agent": {
          "name": "Gemma 4 26B (local)",
          "options": { "reasoningEffort": "none" },
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  },
  "model": "ollama/gemma4-agent",
  "enabled_providers": ["ollama"],
  "autoupdate": false,
  "share": "disabled",
  "agent": {
    "assistant": {
      "description": "General local assistant: reads and searches files, asks before commands and edits; no network",
      "mode": "primary",
      "model": "ollama/gemma4-agent",
      "prompt": "{file:./assistant-prompt.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "question": "allow",
        "write": "ask",
        "external_directory": "ask",
        "edit": {
          "*": "ask",
          "opencode.json": "deny",
          "*/opencode.json": "deny"
        },
        "bash": {
          "*": "ask",
          "ls": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "ls /*": "ask",
          "ls \"/*": "ask",
          "ls '/*": "ask",
          "ls ~*": "ask",
          "ls * /*": "ask",
          "ls * ~*": "ask",
          "cat /*": "ask",
          "cat \"/*": "ask",
          "cat '/*": "ask",
          "cat ~*": "ask",
          "cat \"~*": "ask",
          "cat '~*": "ask",
          "cat * /*": "ask",
          "cat * \"/*": "ask",
          "cat * '/*": "ask",
          "cat * ~*": "ask",
          "cat * \"~*": "ask",
          "cat * '~*": "ask",
          "*..*": "ask",
          "*$*": "ask",
          "*`*": "ask",
          "*;*": "ask",
          "*&*": "ask",
          "*|*": "ask",
          "*>*": "ask",
          "*<*": "ask",
          "*://*": "deny",
          "*curl*": "deny",
          "*wget*": "deny",
          "*ssh *": "deny",
          "*scp *": "deny",
          "*sftp *": "deny",
          "*rsync *": "deny",
          "*nc *": "deny",
          "*telnet *": "deny",
          "*ftp *": "deny"
        }
      }
    },
    "notes": {
      "description": "Takes notes in an Obsidian vault and answers from them; vault only",
      "mode": "primary",
      "model": "ollama/gemma4-agent",
      "prompt": "{file:./notes-prompt.md}",
      "permission": {
        "*": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": "ask",
        "edit": {
          "*": "allow",
          "opencode.json": "deny",
          "*/opencode.json": "deny"
        },
        "bash": {
          "*": "ask",
          "cat *": "allow",
          "cat /*": "ask",
          "cat \"/*": "ask",
          "cat '/*": "ask",
          "cat ~*": "ask",
          "cat \"~*": "ask",
          "cat '~*": "ask",
          "cat * /*": "ask",
          "cat * \"/*": "ask",
          "cat * '/*": "ask",
          "cat * ~*": "ask",
          "cat * \"~*": "ask",
          "cat * '~*": "ask",
          "*..*": "ask",
          "*$*": "ask",
          "*`*": "ask",
          "*;*": "ask",
          "*&*": "ask",
          "*|*": "ask",
          "*>*": "ask",
          "*<*": "ask",
          "*://*": "deny",
          "*curl*": "deny",
          "*wget*": "deny",
          "*ssh *": "deny",
          "*scp *": "deny",
          "*sftp *": "deny",
          "*rsync *": "deny",
          "*nc *": "deny",
          "*telnet *": "deny",
          "*ftp *": "deny"
        }
      }
    }
  }
}
